      "css": "@font-face{font-family:\"ds-Manrope\";src:url(\"/fonts/Manrope.ttf\") format(\"truetype\");font-style:normal;font-weight:200 800;font-display:swap;}@font-face{font-family:\"ds-Sora\";src:url(\"/fonts/Sora.ttf\") format(\"truetype\");font-style:normal;font-weight:100 800;font-display:swap;}.ds-product-card{min-width:0;color:var(--color-ink,#171717);font-family:var(--font-body,\"ds-Manrope\"),sans-serif;line-height:1.6;}.ds-product-link{display:block;color:inherit;text-decoration:none;}.ds-product-image{background:var(--color-surface,#f3f3f5);padding:12px;margin-bottom:18px;}.ds-product-image img{display:block;width:100%;height:185px;max-width:100%;object-fit:contain;background:var(--color-paper,#ffffff);}.ds-product-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;}.ds-product-heading h3{margin:0;font-family:var(--font-display,\"ds-Sora\"),sans-serif;font-size:19px;font-weight:600;line-height:1.25;letter-spacing:-.025em;text-wrap:pretty;overflow-wrap:anywhere;}.ds-product-heading svg{width:18px;height:22px;flex-shrink:0;}.ds-product-brand{margin:6px 0 0;color:var(--color-muted,#56565e);font-size:13px;}.ds-product-price{margin:12px 0 0;font-size:15px;font-weight:750;font-variant-numeric:tabular-nums;}.ds-product-price>span{font-size:12px;font-weight:500;}.ds-product-link:hover .ds-product-heading{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:2px;}.ds-product-link:focus-visible{outline:3px solid var(--color-focus,#43328b);outline-offset:4px;}@media(max-width:600px){.ds-product-image{padding:6px;margin-bottom:12px;}.ds-product-image img{height:122px;}.ds-product-heading{gap:6px;}.ds-product-heading h3{font-size:16px;line-height:1.3;}.ds-product-heading svg{width:15px;height:20px;}.ds-product-brand{font-size:11px;margin-top:5px;}.ds-product-price{font-size:13px;margin-top:9px;}.ds-product-price>span{font-size:10px;display:block;}}"
    },
    {
      "name": "Choix de coloris",
