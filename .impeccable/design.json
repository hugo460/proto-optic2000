      "html": "<fieldset class=\"ds-variant-picker\"><legend>Choisissez votre coloris</legend><div class=\"ds-variant-options\"><button class=\"ds-variant-option\" type=\"button\" aria-pressed=\"true\"><img src=\"/media/91e500d26c-HS833-12F_quarter.webp\" width=\"64\" height=\"35\" alt=\"\" /><span>Cannelle transparente</span><span class=\"ds-variant-check\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4 12 5 5L20 6\"/></svg></span></button><button class=\"ds-variant-option\" type=\"button\" aria-pressed=\"false\"><img src=\"/media/dd557ea82e-RS833-13D_quarter.webp\" width=\"64\" height=\"35\" alt=\"\" /><span>Framboise Lactée Transparente</span><span class=\"ds-variant-check\"></span></button></div></fieldset>",
      "css": "@font-face{font-family:\"ds-Manrope\";src:url(\"/fonts/Manrope.ttf\") format(\"truetype\");font-style:normal;font-weight:200 800;font-display:swap;}.ds-variant-picker{padding:0;margin:0;border:0;min-width:0;color:var(--color-ink,#171717);font-family:var(--font-body,\"ds-Manrope\"),sans-serif;line-height:1.6;}.ds-variant-picker legend{font-size:15px;font-weight:750;margin-bottom:12px;}.ds-variant-options{display:grid;gap:8px;}.ds-variant-option{display:grid;grid-template-columns:64px minmax(0,1fr) 20px;gap:12px;align-items:center;min-height:61px;text-align:left;border:1px solid var(--color-line,#c7c7ce);border-radius:var(--radius-control,4px);padding:7px 12px;background:var(--color-paper,#ffffff);color:inherit;font-family:inherit;font-size:12px;line-height:1.6;cursor:pointer;}.ds-variant-option img{display:block;width:64px;height:35px;object-fit:contain;}.ds-variant-option span{overflow-wrap:anywhere;}.ds-variant-option:hover{background:var(--color-surface,#f3f3f5);}.ds-variant-option[aria-pressed=true]{border:2px solid var(--color-ink,#171717);padding:6px 11px;font-weight:750;}.ds-variant-option:focus-visible{outline:3px solid var(--color-focus,#43328b);outline-offset:4px;}@media(max-width:800px) and (min-width:601px){.ds-variant-option{grid-template-columns:48px minmax(0,1fr) 18px;gap:8px;padding-inline:8px;}.ds-variant-option img{width:48px;}.ds-variant-option[aria-pressed=true]{padding-inline:7px;}}@media(max-width:600px){.ds-variant-option{padding:8px 12px;}.ds-variant-option[aria-pressed=true]{padding:7px 11px;}}"
